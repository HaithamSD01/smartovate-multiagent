# ============================================================
# Fichier modèle de configuration — Système Multi-Agents Smartovate
# Copier ce fichier en `.env` puis renseigner les vraies valeurs.
# ⚠️ Ne JAMAIS commiter le fichier .env (il est dans .gitignore).
# ============================================================

# ==== Azure OpenAI (MAS-TK-01) — Portail Azure > votre ressource > Keys and Endpoint ====
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<votre-cle-azure-openai>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# ==== Redis (MAS-TK-05) — en local: docker run -p 6379:6379 redis ====
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# ==== Cosmos DB (MAS-TK-04) — laisser vide en local (repli fichier JSONL) ====
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=smartovate_mas
COSMOS_CONTAINER=conversations

# ==== API ====
API_KEY_VALUE=dev-local-key